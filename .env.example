# Copy to .env and edit. Everything is optional.

# Public hostname pointing at this server. Enables trusted HTTPS (Let's Encrypt, port 443 only).
# Leave empty for LAN use with a self-signed certificate.
NETSPEAK_DOMAIN=

# Initial admin password (first start only). Empty = random, printed in `docker compose logs`.
NETSPEAK_ADMIN_PASSWORD=

# Contact email for Let's Encrypt expiry notices.
NETSPEAK_EMAIL=

# Pin a release instead of tracking latest, e.g. 1.0.0
NETSPEAK_VERSION=latest
